<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- hu finder -->
	<bean id="sevenDuiziMajiangHuFinder"
		class="com.attic.bj.majiang.rule.judger.hu.finder.SevenDuiziMajiangHuFinder">
	</bean>
	<bean id="dadahuMajiangHuFinder"
		class="com.attic.bj.majiang.rule.judger.hu.finder.DadahuMajiangHuFinder">
	</bean>
	<bean id="allZiMajiangHuFinder"
		class="com.attic.bj.majiang.rule.judger.hu.finder.AllziMajiangHuFinder">
	</bean>
	<bean id="sibaidaMajiangHuFinder"
		class="com.attic.bj.majiang.rule.judger.hu.finder.SibaidaMajiangHuFinder">
	</bean>



	<!-- hu judger -->
	<bean id="huaHuJudger" class="com.attic.bj.majiang.rule.judger.hu.type.MajiangHuaHuJudger">
	</bean>

	<bean id="paiHuJudger" class="com.attic.bj.majiang.rule.judger.hu.type.MajiangPaiHuJudger">
	</bean>

	<bean id="fengyiseHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangFengyiseHuJudger">
	</bean>
	<bean id="qingyiseHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangQingyiseHuJudger">
	</bean>
	<bean id="hunyiseHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangHunyiseHuJudger">
	</bean>
	<bean id="duiduiHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangDuiduiHuJudger">
	</bean>


	<bean id="paodaHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangPaodeHuJudger">
	</bean>
	<bean id="huandaHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangHuandaHuJudger">
	</bean>
	<bean id="wudaHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangWudaHuJudger">
	</bean>
	<bean id="sanbaidaHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangSanbaidaHuJudger">
	</bean>
	<bean id="sibaidaHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangSibaidaHuJudger">
	</bean>





	<bean id="menqingHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangMenqingHuJudger">
	</bean>
	<bean id="dadiaoHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangDadiaoHuJudger">
	</bean>


	<bean id="zfbHuJudger" class="com.attic.bj.majiang.rule.judger.hu.type.MajiangZfbHuJudger">
	</bean>
	<bean id="dnxbHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangDnxbHuJudger">
	</bean>

	<bean id="dandiaoHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangDandiaoHuJudger">
	</bean>
	<bean id="duidaoHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangDuidaoHuJudger">
	</bean>
	<bean id="kadaoHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangKadaoHuJudger">
	</bean>




	<bean id="zimoHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangZimoHuJudger">
	</bean>
	<bean id="gangtoukaihuaHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangGangtoukaihuaHuJudger">
	</bean>
	<bean id="haidilaoyueHuJudger" class="com.attic.bj.majiang.rule.judger.hu.type.MajiangHaidilaoyueHuJudger">
	</bean>

	<bean id="gangHuJudger"
		class="com.attic.bj.majiang.rule.judger.hu.type.MajiangGangHuJudger">
	</bean>



	<!-- majiang helper -->
	<bean id="chiTanShuCalculator" class="com.attic.bj.majiang.helper.ChiTanShuCalculator">
	</bean>

	<bean id="pengGangTanShuCalculator" class="com.attic.bj.majiang.helper.PengGangTanShuCalculator">
	</bean>

	<bean id="allTanShuCalculator" class="com.attic.bj.majiang.helper.AllTanShuCalculator">
		<property name="chiTanShuCalculator" ref="chiTanShuCalculator"></property>
		<property name="pengGangTanShuCalculator" ref="pengGangTanShuCalculator"></property>
	</bean>

	<bean id="majiangGangHelper" class="com.attic.bj.majiang.helper.DefaultMajiangGangHelper">
	</bean>

	<bean id="fileWinLosePlayerStrategy" class="com.attic.bj.core.helper.MemoryWinLosePlayerStrategy">
	<property name="needWinPlayers" value="${winplayers}"></property>
	<property name="needLosePlayers" value="${loseplayers}"></property>
	</bean>

	<bean id="dbWinLosePlayerStrategy" class="com.attic.bj.web.service.impl.DbWinLosePlayerStrategy" init-method="start">
		<property name="gameWinLoseDao" ref="gameWinLoseDao"></property>
	</bean>
	
	<bean id="intWinLosePlayerStrategy" class="com.attic.bj.web.service.impl.IntelligentWinLosePlayerStrategy">
		<property name="gameUserDao" ref="gameUserDao"></property>
	</bean>
	
	
	<bean id="winLosePlayerStrategy" class="com.attic.bj.web.service.impl.ChooseWinLosePlayerStrategy" init-method="start" >
		<property name="gameDictDao" ref="gameDictDao"></property>
		<property name="mapStrategy">
			<map>
				<entry key="int" value-ref="intWinLosePlayerStrategy" />
				<entry key="db" value-ref="dbWinLosePlayerStrategy" />
				<entry key="file" value-ref="fileWinLosePlayerStrategy" />
			</map>
		</property>
	</bean>



</beans>